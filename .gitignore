# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Configuração local de preferências (formato antigo, migrado pro MariaDB)
config.json
config.json.bak

# Credenciais do Domínio e do MariaDB (padrão Janco: data/*.json)
data/dominio_config.json
data/db_config.json
data/*.json

# Backups do banco (contém hashes de senha, regras, dados sensíveis)
data/backups/
*.sql

# Dados sensíveis: planilhas e extratos não devem ir pro Git
*.xlsx
*.xls
*.ofx
*.qfx
*.csv

# Builds do PyInstaller (contem exe empacotado + credenciais em data/)
build/
dist/
dist_testar/
build_testar/
*.exe

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Sistema
Thumbs.db
